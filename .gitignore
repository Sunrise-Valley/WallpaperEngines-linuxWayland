# large images: thumbnails and reference frames do not belong in git
*.png
*.jpg
*.jpeg
!crates/wallpaper-hub/resources/icons/**/*.png

# editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# python
__pycache__/
*.pyc

# local env
.env
*.local
dist/
