# build output
target/
**/target/

# Wallpaper Engine assets must never be committed (see README "Legal")
*.pkg
*.tex
*.mdl
*.mp4
*.webm
*.wav
*.ogg

# evidence / scratch / vendored third-party trees
artifacts/
scratch/
vendor/
shots/
